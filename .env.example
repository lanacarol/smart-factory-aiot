
# ==========================================
# SMART FACTORY AIoT - EXEMPLO DE AMBIENTE
# ==========================================
# Copie este arquivo para .env e configure
# suas próprias credenciais.
# Nunca publique o arquivo .env no GitHub.

# PostgreSQL
POSTGRES_USER=factory_app
POSTGRES_PASSWORD=troque_por_uma_senha_segura
POSTGRES_DB=smart_factory

# RabbitMQ
RABBITMQ_DEFAULT_USER=factory_user
RABBITMQ_DEFAULT_PASS=troque_por_uma_senha_segura

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=troque_por_uma_senha_segura
INFLUXDB_ORG=smart_factory
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=troque_por_um_token_seguro

# MQTT / Mosquitto
MQTT_SIMULATOR_PASSWORD=configure_a_senha_do_simulador
MQTT_GATEWAY_PASSWORD=configure_a_senha_do_gateway

# LLM local (Ollama) - modelo pequeno que roda em CPU
OLLAMA_MODEL=llama3.2:3b
